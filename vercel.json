{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/remote-frames/(.*)",
      "destination": "https://swarag06.github.io/spherex-frames/$1"
    },
    {
      "source": "/((?!assets/|remote-frames/).*)",
      "destination": "/index.html"
    }
  ]
}
